# Copy to .env.local and fill in from your Supabase project settings.
# NEVER commit real values.

# Supabase Postgres via the Supavisor pooler (shard prefix aws-0/aws-1 varies
# per project — copy the exact host from Dashboard -> Connect).
# DATABASE_URL: transaction mode (app runtime). DIRECT_URL: session mode
# (Prisma CLI/migrations — see prisma.config.ts).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase client (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Comma-separated emails that receive the owner role on signup
OWNER_EMAILS="you@example.com"

# Shared secret signing short-lived match WebSocket connect tickets and
# authenticating Worker→Next internal calls. Must be identical in the Next
# environment and the Worker's secrets. At least 32 bytes.
REALTIME_SHARED_SECRET=

# Public origin of the realtime Worker, e.g. https://jumbogames-realtime.workers.dev
NEXT_PUBLIC_REALTIME_URL=http://localhost:8787
