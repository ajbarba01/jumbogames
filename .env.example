# Copy to .env.local and fill in from your Supabase project settings.
# NEVER commit real values.

# Supabase Postgres via the Supavisor pooler (shard prefix aws-0/aws-1 varies
# per project — copy the exact host from Dashboard -> Connect).
# DATABASE_URL: transaction mode (app runtime). DIRECT_URL: session mode
# (Prisma CLI/migrations — see prisma.config.ts).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase client (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Comma-separated emails that receive the owner role on signup
OWNER_EMAILS="you@example.com"

# Two distinct secrets, each at least 32 bytes, each identical in the Next
# environment and the Worker's secrets. Generate with: openssl rand -base64 32
#
# Signs short-lived match WebSocket connect tickets. A signing key only — it is
# never transmitted, so keep it out of anything that logs request headers.
REALTIME_TICKET_KEY=
# Bearer credential on Worker→Next internal calls (hydrate/persist). This one
# does travel in a header, so treat it as the more exposed of the two; that
# exposure gap is exactly why it must not also be the ticket signing key.
REALTIME_INTERNAL_SECRET=

# Public origin of the realtime Worker, e.g. https://jumbogames-realtime.workers.dev
NEXT_PUBLIC_REALTIME_URL=http://localhost:8787

# Set to 1 to route live matches over the realtime Worker instead of Supabase
# Realtime. Removed once the socket path is the only path.
NEXT_PUBLIC_REALTIME_WS=0
