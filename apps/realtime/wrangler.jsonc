{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jumbogames-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "MATCH_ROOM", "class_name": "MatchRoom" }],
  },
  // SQLite-backed classes are the only kind available on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchRoom"] }],
  "vars": { "ORIGIN_URL": "http://localhost:3000" },
}
