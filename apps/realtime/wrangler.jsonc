{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jumbogames-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "MATCH_ROOM", "class_name": "MatchRoom" }],
  },
  // SQLite-backed classes are the only kind available on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchRoom"] }],
  // Top-level is the dev/default environment: `wrangler dev` hydrates from the
  // local Next server. E2E overrides this per-spawn (see playwright.config.ts),
  // because that app deliberately runs on a different port.
  "vars": { "ORIGIN_URL": "http://localhost:3000" },
  "env": {
    // Deploy with `--env production`. `vars` and `durable_objects` are
    // non-inheritable, so both are restated here rather than falling through
    // from above — omitting the binding would deploy a Worker with no
    // MatchRoom. `name` is pinned because a named environment otherwise
    // deploys as `<name>-production`, changing the public URL the Next app
    // was configured to call.
    "production": {
      "name": "jumbogames-realtime",
      "vars": { "ORIGIN_URL": "https://jumbogames.vercel.app" },
      "durable_objects": {
        "bindings": [{ "name": "MATCH_ROOM", "class_name": "MatchRoom" }],
      },
    },
  },
}
